# Trinity Agent Backend Environment Variables

# Application
APP_NAME=Trinity Agent API
DEBUG=False
API_PREFIX=/api/v1

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32_TO_GENERATE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
POSTGRES_USER=trinity
POSTGRES_PASSWORD=trinity_pass_CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=trinity_db

# Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=trinity_neo4j_CHANGE_ME

# ChromaDB Vector Database
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=./chroma_data

# Redis (for background tasks)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Agent Configuration
DEFAULT_LLM_MODEL=llama3.1:8b-instruct
MAX_RETRIES=3
EXECUTION_TIMEOUT=30
ENABLE_SELF_HEALING=True
CIRCUIT_BREAKER_ENABLED=True

# Scan Configuration
DEFAULT_ALLOWED_SUBNET=192.168.1.0/24
